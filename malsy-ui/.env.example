# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# OpenAI (Sora + script generation)
OPENAI_API_KEY=

# Supabase Storage (lesson videos + interactive images)
# Project Settings → API in Supabase dashboard
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Buckets must be public (or use signed URLs) for browser playback
SUPABASE_VIDEO_BUCKET=lesson-videos
SUPABASE_IMAGES_BUCKET=lesson-images
